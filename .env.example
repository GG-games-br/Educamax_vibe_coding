# ==============================================================
# CONFIGURAÇÃO DE AMBIENTE - EDUCAMAX
# Copie este arquivo para '.env' para desenvolvimento local
# ==============================================================

# Chave secreta para criptografia de sessões e CSRF
SECRET_KEY=educamax_chave_secreta_longa_e_aleatoria_para_producao_2026

# Modo da aplicação: 'development' (para debug local) ou 'production' (na nuvem)
FLASK_ENV=development

# --------------------------------------------------------------
# BANCO DE DADOS MYSQL / MARIADB
# --------------------------------------------------------------
# Opção 1: Variáveis individuais (Padrão local e Railway)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=escola_db

# Opção 2: URL de conexão única (Render, Railway MYSQL_URL, AWS)
# MYSQL_URL=mysql://root:senha@host:3306/escola_db

# --------------------------------------------------------------
# CONTROLE DE MODO OFFLINE / RESILIÊNCIA
# --------------------------------------------------------------
# 'true': se o MySQL estiver offline, ativa dados demonstrativos na tela
# 'false': se o MySQL estiver offline, lança erro para diagnóstico em produção
ALLOW_OFFLINE_FALLBACK=true
